# ==================== NexMotor 后端环境变量模板 ====================
# 使用方法：复制本文件为 .env 并按需修改
#   cp .env.example .env

# 服务器监听端口（默认 5000）
PORT=5000

# 运行环境：development | production
# 生产环境（且 backend/src/ssl/ 下存在 privkey.pem 与 fullchain.pem 时）将启用 HTTPS 监听 443
NODE_ENV=development

# ==================== JWT 认证 ====================
# JWT 签名密钥：必须为至少 32 位的强随机字符串！
# 生成示例：openssl rand -base64 48
JWT_SECRET=please_replace_with_a_strong_random_secret_at_least_32_chars

# JWT 过期时间（默认 7 天）
JWT_EXPIRES_IN=7d

# ==================== 跨域（CORS） ====================
# 允许跨域访问的来源，多个用英文逗号分隔（生产环境必填，如 https://yourdomain.com）
# 开发环境默认允许 http://localhost:3000 与 http://localhost:5173
CORS_ORIGIN=https://yourdomain.com

# ==================== 管理员初始密码 ====================
# 首次启动时用于创建 admin 账号的密码
# 未配置时，系统将自动生成 16 位随机密码并打印到启动日志（仅首次创建时提示一次）
ADMIN_PASSWORD=

# ==================== 调试选项 ====================
# 是否打印 SQL 与参数日志（仅调试用，生产建议保持 false 或删除）
# LOG_SQL=true
